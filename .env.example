# Vorlage fuer die lokale .env des Compose-Stacks (docker-compose.yml).
# NICHT einchecken; `scripts\sm.ps1` erzeugt die echte .env beim ersten
# Start automatisch mit starken Zufallswerten. Formate wie in
# deploy/k8s/SECRETS.md: Seeds sind 32 Bytes Base64, Passwoerter/Tokens
# lange Zufallsstrings.

# PostgreSQL-Superuser-Passwort (steckt auch in den DATABASE_URLs).
POSTGRES_PASSWORD=

# Shared Secret der /internal-Routen (dasselbe fuer alle Dienste).
INTERNAL_TOKEN=

# identity: Krypto-Schluessel (Base64-32-Byte-Seeds).
CDS_OPRF_KEY=
SEALED_SENDER_TRUST_ROOT=

# kt: Transparenz-Log-Schluessel (Base64-32-Byte-Seeds, muessen Neustarts
# ueberleben, sonst scheitert der Integritaets-Check des Logs).
KT_SIGNING_KEY=
KT_VRF_KEY=

# integrations: Ed25519-Signierschluessel der Praesenz-Webhooks (Seed).
INTEGRATIONS_WEBHOOK_SIGNING_KEY=

# delivery: Web-Push (F1). VAPID-Privatschluessel (P-256, base64url ohne
# Padding von 32 Bytes) weckt geschlossene Browser bei neuen Nachrichten.
# LEER lassen = Push aus (der Chat-Kern haengt nicht daran). VAPID_SUBJECT
# ist eine Kontaktangabe des Betreibers (mailto:/https:), die der
# Push-Dienst bei Missbrauch anspricht.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@securemessenger.local

# media/MinIO: Objektspeicher-Zugangsdaten.
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=

# Keycloak (nur Profil sso): Bootstrap-Admin-Passwort.
KEYCLOAK_ADMIN_PASSWORD=
